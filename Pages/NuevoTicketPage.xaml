<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="MesaAyudaTI.Pages.NuevoTicketPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    NavigationCacheMode="Required"
    mc:Ignorable="d">

    <ScrollViewer>
        <StackPanel MaxWidth="860" Padding="32,20,32,32" HorizontalAlignment="Left" Spacing="16">
            <StackPanel Spacing="4">
                <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="Nuevo ticket" />
                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="El equipo de TI lo verá en la cola para asignarlo, comentarlo y cerrarlo."
                    TextWrapping="Wrap" />
            </StackPanel>

            <InfoBar x:Name="FormInfo" IsClosable="True" IsOpen="False" />

            <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Quién reporta" />
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBox
                    x:Name="RequesterBox"
                    Header="Solicitante"
                    PlaceholderText="Nombre de quien pide ayuda" />
                <ComboBox
                    x:Name="DepartmentBox"
                    Grid.Column="1"
                    HorizontalAlignment="Stretch"
                    Header="Área"
                    IsEditable="True"
                    PlaceholderText="Recepción, consultorio, quirófano…" />
            </Grid>
            <TextBox
                x:Name="AssetBox"
                Header="Equipo o puesto"
                PlaceholderText="Opcional. Por ejemplo PC-REC-03 o IMP-REC-01" />

            <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Qué ocurre" />
            <TextBox
                x:Name="TitleBox"
                Header="Título"
                PlaceholderText="El problema en una frase" />
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <ComboBox
                    x:Name="CategoryBox"
                    HorizontalAlignment="Stretch"
                    DisplayMemberPath="Label"
                    Header="Categoría" />
                <ComboBox
                    x:Name="PriorityBox"
                    Grid.Column="1"
                    HorizontalAlignment="Stretch"
                    DisplayMemberPath="Label"
                    Header="Prioridad" />
            </Grid>
            <TextBox
                x:Name="DescriptionBox"
                AcceptsReturn="True"
                Header="Descripción"
                MinHeight="140"
                PlaceholderText="Desde cuándo pasa, a quién afecta y qué ya se intentó"
                TextWrapping="Wrap" />

            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Click="Create_Click" Content="Crear ticket" Style="{StaticResource AccentButtonStyle}" />
                <Button Click="Clear_Click" Content="Limpiar" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
