<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="MesaAyudaTI.Pages.PanelPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:MesaAyudaTI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:MesaAyudaTI.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:MesaAyudaTI.Models"
    NavigationCacheMode="Required"
    mc:Ignorable="d">

    <ScrollViewer>
        <Grid Padding="32,20,32,28" RowSpacing="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid>
                <StackPanel Spacing="4">
                    <TextBlock x:Name="GreetingText" Style="{StaticResource TitleTextBlockStyle}" />
                    <TextBlock
                        x:Name="DateText"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource BodyTextBlockStyle}" />
                </StackPanel>
                <Button
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Click="NewTicket_Click"
                    Style="{StaticResource AccentButtonStyle}"
                    ToolTipService.ToolTip="Ctrl+N">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon
                            VerticalAlignment="Center"
                            FontSize="14"
                            Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                            Glyph="&#xE710;" />
                        <TextBlock
                            VerticalAlignment="Center"
                            Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                            Text="Nuevo ticket" />
                    </StackPanel>
                </Button>
            </Grid>

            <InfoBar
                x:Name="SaveErrorBar"
                Grid.Row="1"
                IsClosable="False"
                IsOpen="False"
                Severity="Error" />

            <Grid Grid.Row="2" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <controls:StatCard
                    x:Name="OpenCard"
                    Glyph="&#xE823;"
                    Label="Nuevos, sin tomar"
                    Tint="{ThemeResource AccentFillColorDefaultBrush}"
                    ToolTipService.ToolTip="Tickets en estado Nuevo"
                    Value="0" />
                <controls:StatCard
                    x:Name="ProgressCard"
                    Grid.Column="1"
                    Glyph="&#xE895;"
                    Label="En curso o en espera"
                    Tint="{ThemeResource SystemFillColorAttentionBrush}"
                    Value="0" />
                <controls:StatCard
                    x:Name="CriticalCard"
                    Grid.Column="2"
                    Glyph="&#xE7BA;"
                    Label="Críticos abiertos"
                    Tint="{ThemeResource SystemFillColorCriticalBrush}"
                    Value="0" />
                <controls:StatCard
                    x:Name="ResolvedCard"
                    Grid.Column="3"
                    Glyph="&#xE73E;"
                    Label="Resueltos en 7 días"
                    Tint="{ThemeResource SystemFillColorSuccessBrush}"
                    Value="0" />
            </Grid>

            <Grid Grid.Row="3" ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource CardBorderStyle}" Padding="8,16,8,8">
                    <StackPanel Spacing="8">
                        <Grid Margin="12,0,8,0">
                            <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Actividad reciente" />
                            <HyperlinkButton
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Click="ViewAll_Click"
                                Content="Ver todos" />
                        </Grid>
                        <ListView
                            x:Name="RecentList"
                            IsItemClickEnabled="True"
                            ItemClick="RecentList_ItemClick"
                            SelectionMode="None"
                            ScrollViewer.VerticalScrollBarVisibility="Disabled">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Padding" Value="4,2" />
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="models:Ticket">
                                    <Grid Padding="8,8" ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="4" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border
                                            Width="4"
                                            VerticalAlignment="Stretch"
                                            Background="{x:Bind Priority, Mode=OneWay, Converter={StaticResource PriorityBrushConverter}}"
                                            CornerRadius="2" />
                                        <StackPanel Grid.Column="1" Spacing="2">
                                            <TextBlock
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Style="{StaticResource CaptionTextBlockStyle}"
                                                Text="{x:Bind Code}" />
                                            <TextBlock
                                                MaxLines="1"
                                                Style="{StaticResource BodyStrongTextBlockStyle}"
                                                Text="{x:Bind Title, Mode=OneWay}"
                                                TextTrimming="CharacterEllipsis" />
                                            <TextBlock
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Style="{StaticResource CaptionTextBlockStyle}"
                                                Text="{x:Bind MetaLine, Mode=OneWay}"
                                                TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <TextBlock
                                            Grid.Column="2"
                                            VerticalAlignment="Center"
                                            Foreground="{x:Bind Status, Mode=OneWay, Converter={StaticResource StatusBrushConverter}}"
                                            Style="{StaticResource CaptionTextBlockStyle}"
                                            Text="{x:Bind StatusLabel, Mode=OneWay}" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <TextBlock
                            x:Name="EmptyRecentText"
                            Margin="12,8,12,12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="Todavía no hay tickets."
                            Visibility="Collapsed" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource CardBorderStyle}">
                    <StackPanel Spacing="14">
                        <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Cola por categoría" />
                        <ItemsControl x:Name="CategoryList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="local:CategoryBar">
                                    <StackPanel Margin="0,0,0,12" Spacing="4">
                                        <Grid>
                                            <TextBlock Style="{StaticResource BodyTextBlockStyle}" Text="{x:Bind Name}" />
                                            <TextBlock
                                                HorizontalAlignment="Right"
                                                Style="{StaticResource BodyStrongTextBlockStyle}"
                                                Text="{x:Bind Count}" />
                                        </Grid>
                                        <ProgressBar Maximum="{x:Bind Maximum}" Value="{x:Bind Count}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock
                            x:Name="EmptyCategoryText"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="No hay tickets abiertos."
                            TextWrapping="Wrap"
                            Visibility="Collapsed" />
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </ScrollViewer>
</Page>
